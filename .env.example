# Copy to /etc/coffeeshop/env on the server (see deploy/README.md) and fill in.
# Lines starting with # are optional.

# --- Required in production ---------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=coffee-demo.duckdns.org
CSRF_TRUSTED_ORIGINS=https://coffee-demo.duckdns.org
TIME_ZONE=America/Mexico_City

# --- Paths (keep data outside the code directory so deploys never touch it) ---
DB_PATH=/var/lib/coffeeshop/db.sqlite3
MEDIA_ROOT=/var/lib/coffeeshop/media
CACHE_DIR=/var/lib/coffeeshop/cache

# --- Behind Caddy / nginx ------------------------------------------------
TRUST_PROXY=True
# SECURE_SSL_REDIRECT=True
# Raise to 31536000 (1 year) once HTTPS works:
SECURE_HSTS_SECONDS=3600

# --- Email (console backend is used when EMAIL_BACKEND is unset) -----------
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=Coffee Shop <orders@coffee-demo.duckdns.org>
